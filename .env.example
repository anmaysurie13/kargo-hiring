# Server-only secrets. Never prefix any of these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

RESEND_API_KEY=
EMAIL_FROM="Kargo Hiring <onboarding@resend.dev>"
# While set, every email goes to this address instead of the candidate. Sending is blocked while blank.
TEST_RECIPIENT_EMAIL=
# Set to "true" only in a real deployment where you intend to email candidates directly.
ALLOW_REAL_SEND=

DASHBOARD_PASSWORD=
